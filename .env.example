# Optional: the AI assistant. Keys stay on the server; the browser never sees them.
# Never commit a real key.

# Google Gemini (free tier available): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-lite-latest)
GEMINI_MODEL=
# Tried in order when the main model is overloaded or too slow (default: gemini-flash-latest)
GEMINI_FALLBACK_MODELS=
# Per-model timeout in ms before falling back (default: 15000)
GEMINI_TIMEOUT_MS=

# Anthropic Claude (paid): create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# Optional: force one provider (gemini or claude). By default Gemini is used when
# its key is set, otherwise Claude, otherwise the offline tutor.
AI_PROVIDER=

# Requests per minute per visitor IP for the assistant (default: 20)
ASSISTANT_RATE_LIMIT=

# Optional: absolute path of the private textbook index when it is not at server/textbook/index.json
# (the index is copyrighted Ministry text and is not in the repository; see docs/security-and-content.md)
TEXTBOOK_INDEX_PATH=

# Port for the API / production server (not used on Vercel; hosts that run `npm start` set it themselves)
PORT=8787
